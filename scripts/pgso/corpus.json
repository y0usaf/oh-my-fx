{
  "version": 1,
  "intentional_exclusions": {
    "notifications.test.ts": "The suite requires a real model credential and is not deterministic.",
    "tui-agent.test.ts": "The suite requires a real model credential and is not deterministic.",
    "tui-command-permissions.test.ts": "The file contains a sound scenario and cannot be run safely as a whole."
  },
  "defaults": {
    "cwd": "tests/e2e",
    "env_set": {
      "FX_AUTO_UPGRADE": "0",
      "FX_SOUND": "0",
      "NO_COLOR": "1"
    },
    "env_unset": [
      "AI_GATEWAY_API_KEY",
      "VERCEL_OIDC_TOKEN"
    ],
    "timeout_seconds": 1800,
    "requires_tmux": true
  },
  "scenarios": [
    {
      "name": "direct-help",
      "argv": [
        "{binary}",
        "help"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-version",
      "argv": [
        "{binary}",
        "--version"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-status",
      "argv": [
        "{binary}",
        "status",
        "--json"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-background",
      "argv": [
        "{binary}",
        "background",
        "--json"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-doctor",
      "argv": [
        "{binary}",
        "doctor",
        "--json"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-sessions",
      "argv": [
        "{binary}",
        "sessions",
        "--json"
      ],
      "cwd": ".",
      "env_set": {
        "FX_SKIP_ONBOARDING": "1"
      },
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    }
  ],
  "verification_scenarios": []
}