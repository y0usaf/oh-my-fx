+fn evalExternalEnv(
+    shell: anytype,
+    args: []const []const u8,
+    assignments: []const ast.Assignment,
+    option: []const u8,
+) EvalError!result.EvalResult {
+    const env_entries = try makeEnvBuiltinEntries(shell, assignments, &.{});
+    const envp = try makeEnvpFromEntries(shell, env_entries);
+    const shell_path = if (shell.state.getVariable("PATH")) |variable| variable.value else envPath(shell.env);
+    const search_path = envEntriesPath(env_entries) orelse shell_path orelse defaultUtilityPath();
+    const utility_path = try findCommandPath(shell, "env", search_path) orelse {
+        const message = try std.fmt.allocPrint(
+            shell.scratchAllocator(),
+            "env: {s}: unsupported by the builtin and no env utility found in PATH\n",
+            .{option},
+        );
+        try shell.host.writeAll(.stderr, message);
+        return .{ .status = 2 };
+    };
+    const path = try shell.scratchAllocator().dupeSentinel(u8, utility_path, 0);
+    const request: host_mod.SpawnRequest = .{
+        .path = path,
+        .argv = try makeExecArgv(shell, args),
+        .fallback_argv = try makeShellFallbackArgv(shell, path, args[1..]),
+        .envp = envp,
+        .default_signals = if (shell.state.options.monitor) &job_control_signals else &.{},
+    };
+    notifyForegroundCommand(shell, "env");
+    defer notifyForegroundCommand(shell, null);
+    const waited = try shell.host.spawnAndWait(request);
+    return .{ .status = waited.shellStatus() };
+}
